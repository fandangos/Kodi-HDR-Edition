-        } else if (NPT_StringsEqual(arg, "--ssl-accept-hostname-mismatch")) {
-            tls_options |= NPT_HttpTlsConnector::OPTION_ACCEPT_HOSTNAME_MISMATCH;
-#endif
-        } else if (!url_set) {
-            NPT_Result result = url.Parse(arg);
