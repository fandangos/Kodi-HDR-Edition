-            NPT_ParseInteger(*argv++, max_requests);
-        } else if (NPT_StringsEqual(arg, "--max-time")) {
-            NPT_ParseInteger(*argv++, max_time);
-        } else if (NPT_StringsEqual(arg, "--ssl-client-cert")) {
-            tls_cert_filename = *argv++;
-            if (tls_cert_filename == NULL) {
