-/*
-*  Remove trailing white space from a string
-*/
-static void strchomp(char* str)
-{
-    if (!str) return;
-    char* e = str+NPT_StringLength(str)-1;
-
-    while (e >= str && *e) {
-        if ((*e != ' ')  &&
-            (*e != '\t') &&
-            (*e != '\r') &&
-            (*e != '\n'))
-        {
-            *(e+1) = '\0';
-            break;
-        }
-        --e;
-    }
-}
