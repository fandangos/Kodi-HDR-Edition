-        m_Id(id),
-        m_Server(server),
-        m_State(IDLE),
-        m_Verbose(false) {}
-    
-    // NPT_Runnable methods
-    virtual void Run();
-    NPT_Result Respond();
-    
-    // members
-    unsigned int              m_Id;
-    ZipHttpServer*            m_Server;
-    NPT_SharedVariable        m_State;
