<mediasconfig>
  <rules>
    <!--
      The <subs> entries below reference "xysubfilter_internal", which is resolved by
      path (userdata/dsplayer/, then system/players/dsplayer/) and otherwise falls back
      to a system registered XySubFilter. Adding a subtitle filter to the graph is what
      lets the OSD list and select subtitle tracks. Without one, DSPlayer falls back to
      its internal libsubs manager, which is unavailable for the madVR renderer and
      leaves the subtitle list empty.

      If the filter cannot be found the graph is built without it and playback still
      works, only subtitle support is lost.

      DVD rules are deliberately left without a subtitle filter, DVD subtitles are
      handled by the dvd navigator.
    -->

    <!-- DVD RULES -->
    <!-- Iso still return a crash on this filter. -->
    <!-- Blu-ray images expose their PGS tracks through the splitter, so unlike the
         dvd rules below this one does need a subtitle filter. -->
    <!-- An unpacked disc is played by selecting BDMV/index.bdmv, which is the file the
         list offers for a disc folder; MovieObject.bdmv and the 8.3 INDEX.BDM name reach
         the same disc. All of them are handed to the source as they stand and it works
         out the disc's root for itself, so the disc behaves exactly as its image does. -->
    <!-- "iso" says only that this is a disc image, not which kind of disc is inside, and a
         DVD image handed to the Blu-ray source dies at "error opening file BDMV\index.bdmv"
         with nothing on screen. disctype makes the two rules choose by what the image
         actually holds: it is answered by looking for BDMV/index.bdmv and then for
         VIDEO_TS/VIDEO_TS.IFO, which is the same test Kodi's own player uses. A disc folder
         is recognised from its path, so index.bdmv still reaches the Blu-ray rule. -->
    <rule filetypes="iso|bdmv|bdm" disctype="bluray">
      <!-- Read the disc through libbluray rather than letting the splitter open the
           image itself. libbluray uses the disc's own title list and copes with images
           the splitter cannot open at all. -->
      <source filter="internal_bluraysource" />
      <splitter filter="lavf_splitter" />
      <video filter="lavvideodec" />
      <audio filter="lavaudiodec" />
      <subs filter="xysubfilter_internal" />
    </rule>
    <!-- A DVD image, read through libdvdnav the same way: the disc's own navigation runs the
         menus and decides what plays, and Kodi's virtual file system reaches an image on a
         network share that no DirectShow filter could open. -->
    <rule filetypes="iso|img|udf" disctype="dvd">
      <source filter="internal_dvdsource" />
      <splitter filter="lavf_splitter" />
      <video filter="lavvideodec" />
      <audio filter="lavaudiodec" />
      <!-- The splitter finds the disc's vobsub tracks and offers them, and without a renderer
           they are listed and then refused with "No subtitle renderer available". The disc's
           menu buttons are a different matter and are drawn by CDSDvdNavigator, which is the
           only thing that can know which button is selected. -->
      <subs filter="xysubfilter_internal" />
    </rule>
    <!-- An unpacked DVD is played by selecting /dvdfolder/VIDEO_TS/VIDEO_TS.ifo, which is the
         file the list offers for a disc folder. It takes the same libdvdnav path an image
         does, so a disc folder behaves exactly as its image would -- the same tidy-up the
         Blu-ray side got for BDMV folders in the section before this one.

         This rule used to point at Microsoft's DVD Navigator, which is still registered on
         Windows and still works, but can only ever open a real directory: an image would have
         to be mounted to a drive letter first. Nothing routes to it now. It also asked for
         mpaaudiodec, which needs MpaDecFilter.ax, which this build does not ship -- so every
         DVD died at "Failed to create filter mpaaudiodec" before a graph existed. -->
    <rule filetypes="ifo">
      <source filter="internal_dvdsource" />
      <splitter filter="lavf_splitter" />
      <video filter="lavvideodec" />
      <audio filter="lavaudiodec" />
      <subs filter="xysubfilter_internal" />
    </rule>
    <!-- END DVD RULES -->
    <rule filetypes="avi|divx">
      <source filter="lavfsplitter" />
      <splitter filter="lavf_splitter" />
      <video filter="lavvideodec" />
      <audio filter="lavaudiodec" />
      <subs filter="xysubfilter_internal" />
    </rule>
    <rule filetypes="ogm">
      <source filter="lavfsplitter" />
      <splitter filter="oggsplitter" />
      <video filter="mpcvideodec" />
      <audio filter="lavaudiodec" />
      <subs filter="xysubfilter_internal" />
    </rule>
      <rule filetypes="flv">
      <source filter="lavfsplitter" />
      <splitter filter="lavf_splitter" />
      <video filter="mpcvideodec" />
      <audio filter="lavaudiodec" />
      <subs filter="xysubfilter_internal" />
    </rule>
    <rule filetypes="mp4">
      <source filter="lavfsplitter" />
      <splitter filter="lavf_splitter" />
      <video filter="lavvideodec" />
      <audio filter="lavaudiodec" />
      <subs filter="xysubfilter_internal" />
    </rule>
    <rule filetypes="mov|m4v">
      <source filter="lavfsplitter" />
      <splitter filter="lavf_splitter" />
      <video filter="lavvideodec" />
      <audio filter="lavaudiodec" />
      <subs filter="xysubfilter_internal" />
    </rule>
    <rule filetypes="m2v">
      <source filter="lavfsplitter" />
      <splitter filter="lavf_splitter" />
      <video filter="lavvideodec" />
      <audio filter="lavaudiodec" />
      <subs filter="xysubfilter_internal" />
    </rule>
    <rule filetypes="ts|mpeg|mpg|m2ts">
      <source filter="lavfsplitter" />
      <splitter filter="lavf_splitter" />
      <video filter="cyberlinkvideodec" />
      <audio filter="lavaudiodec" />
      <subs filter="xysubfilter_internal" />
    </rule>
    <rule filetypes="mkv">
      <source filter="lavfsplitter" />
      <splitter filter="lavf_splitter" />
      <video filter="lavvideodec" />
      <!-- You can do like that to specifie a DXVA only filters.
      If you want to use the same filter for DXVA and non DXVA media, just add
      a single <video> line.
      <video>
        <video dxva="true" filter="mpcvideodec" />
        <video filter="mpcvideodec" />
      </video> -->
      <audio filter="lavaudiodec" />
      <subs filter="xysubfilter_internal" />
      <!--<extra>
        <extra filter="ac3filter" />
        <extra filter="dcgraphiceq" />
      </extra>-->

      <!-- Shaders example

      Must starts with <shaders> and ends with </shaders>

      Inside, specify your shader like that :
        <shader id="x" dxva="true" videocodec="h264" audiocodec="mp3" ... />

      x is the ID of the shader, declared in the /system/DSPlayer/Shaders/shaders.xml file
      -->
      <!--
      <shaders>
        <shader id="7" />
      </shaders>
      -->
    </rule>
    <rule filetypes="wmv">
      <source filter="wmasfreader" />
      <splitter filter="wmasfreader" />
      <video filter="wmvideodecoder" />
      <audio filter="wmaudiodecoder" />
    </rule>

    <!-- You need Real Alternative in order to read real media files -->
    <rule filetypes="rmvb">
      <source filter="realsource" />
      <splitter filter="realsplitter" />
      <video filter="realvideodec" />
      <audio filter="realaudiodec" />
    </rule>

    <rule protocols="http">
      <source filter="urlfilesource" />
      <splitter filter="avsplitter" />
      <video filter="cyberlinkvideodec" />
      <audio filter="lavaudiodec" />
    </rule>

  </rules>
</mediasconfig>
